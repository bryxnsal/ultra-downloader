{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Ultra Downloader",
  "version": "0.2.3",
  "identifier": "com.ultra.downloader",
  "build": {
    "beforeDevCommand": "pnpm --filter @ultra/desktop dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm --filter @ultra/desktop build",
    "frontendDist": "../desktop/dist"
  },
  "app": {
    "enableGTKAppId": true,
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "publisher": "Brayan Salazar",
    "copyright": "Copyright © 2026 Brayan Salazar",
    "shortDescription": "High-Speed Dynamic Download Manager",
    "longDescription": "High-performance Multi-threaded Dynamic Downloader inspired by IDM",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["udm"]
      }
    },
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDQyQTI3QTQ0MTRDNTIxRjkKUldUNUljVVVSSHFpUXJwbzZZNmJ2elM5V1g2YnhJQVNuakdoSXMyV2FhVHZHL1BZY2ZWQm1WN3cK",
      "endpoints": [
        "https://github.com/bryxnsal/ultra-downloader/releases/latest/download/latest.json"
      ]
    }
  }
}
